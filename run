#!/usr/bin/env bash

set -euo pipefail

HUGO_IMAGE='docker.io/hugomods/hugo:latest'

log() {
    printf "%s\n" "$*" >&2
}

ENGINE="$(command -v podman 2>/dev/null || command -v docker 2>/dev/null || true)"

if [ -z "$ENGINE" ]; then
    log 'Neither Docker nor Podman are available.'
    exit 1
fi

if ! "$ENGINE" info &>/dev/null; then
    log "Failed to execute $ENGINE. Check if you have the correct permissions."
    exit 1
fi

case "${1:-}" in
    hugo | npm)
        ENTRYPOINT="$1"
        shift
        ;;
    *)
        log "Usage: $0 <hugo|npm> [parameters]"
        exit 1
        ;;
esac

ARGS=(run --rm --volume "$PWD:/src:Z" --entrypoint "$ENTRYPOINT")

# Only attach a terminal when there is one, so the wrapper also works from CI
# and pipes.
if [ -t 0 ] && [ -t 1 ]; then
    ARGS+=(--tty --interactive)
fi

# Only the dev server needs to be reachable from the host.
if [ "$ENTRYPOINT" = hugo ] && [ "${1:-}" = server ]; then
    ARGS+=(--net=host)
fi

# Rootless Podman maps the container's root to the invoking user, so files it
# writes to /src already come out owned by us. Docker runs as the real root and
# would leave root-owned files behind, so there we run as the host user. That
# user has no passwd entry in the image, hence the explicit writable HOME for
# the npm and Hugo caches.
case "$ENGINE" in
    *docker*)
        ARGS+=(--user "$(id -u):$(id -g)" --env HOME=/tmp)
        ;;
esac

exec "$ENGINE" "${ARGS[@]}" "$HUGO_IMAGE" "$@"
