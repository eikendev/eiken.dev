{
	"extends": ["html-validate:recommended"],
	"rules": {
		"attr-quotes": "off",
		"no-inline-style": "off",
		"doctype-style": "off",
		"prefer-tbody": "off",
		"long-title": ["error", { "maxlength": 90 }],
		"no-raw-characters": ["error", { "relaxed": true }],
		"valid-id": ["error", { "relaxed": true }]
	}
}
